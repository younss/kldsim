# Copy to .env and fill in real secrets before running `podman-compose up`.
# Generate strong random values for the three secrets below, e.g.:
#   openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_USER=kldsim
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kldsim

# --- Application secrets (required, no safe defaults) ---
JWT_ACCESS_SECRET=change-me-32-chars-minimum-random-string
JWT_REFRESH_SECRET=change-me-a-different-32-chars-minimum-string
MASTER_ENCRYPTION_KEY=change-me-used-to-encrypt-byo-ai-api-keys-at-rest

# --- Local AI (Ollama) ---
OLLAMA_DEFAULT_MODEL=gemma3:4b
OLLAMA_PORT=11434

# --- Networking ---
# CORS_ORIGIN should match the URL you'll open in the browser (the web
# container's published port). Same-origin in the default topology, so this
# rarely needs to change.
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080
API_PORT=4000

LOG_LEVEL=info
