# Templated at container start (see web-entrypoint.sh) — ${RESOLVER_IP} is
# the container's own DNS resolver (Podman/Docker's embedded DNS), read from
# /etc/resolv.conf at runtime since it differs per network and per host.
#
# proxy_pass targets are written through a variable ($upstream_api /
# $upstream_socket) rather than as a literal hostname: nginx only consults
# the `resolver` directive — and therefore only re-resolves DNS on each
# request within `valid` — for a proxy_pass whose target comes from a
# variable. A literal `proxy_pass http://api:4000` resolves once when the
# worker starts and never again, so if the api container is ever recreated
# (a redeploy, a crash-restart) with a new internal IP, nginx keeps routing
# to the dead address until nginx itself restarts. This is what actually
# happened during development of this image, which is why the fix is here
# instead of the simpler literal form.
resolver ${RESOLVER_IP} valid=10s ipv6=off;

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /api/ {
    set $upstream_api http://api:4000;
    proxy_pass $upstream_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    set $upstream_socket http://api:4000;
    proxy_pass $upstream_socket;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location /healthz {
    set $upstream_health http://api:4000;
    proxy_pass $upstream_health/healthz;
  }

  # SPA fallback — everything else is client-side routed.
  location / {
    try_files $uri /index.html;
  }
}
